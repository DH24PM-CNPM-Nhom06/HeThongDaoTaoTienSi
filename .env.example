# Shared template. START_DTMS.bat creates .env.local and generates missing secrets.
MARIADB_DATABASE=dtms_db
MARIADB_USER=dtms_app
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
JWT_KEY=

# Local host ports. Frontend defaults to 4174 to avoid the existing 4173 dev server.
FRONTEND_HOST_PORT=4174
API_HOST_PORT=8080
MARIADB_HOST_PORT=3307
