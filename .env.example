# Copy to .env and replace the example credentials before deployment.
DB_NAME=dtms
DB_USER=dtms
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password
JWT_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=DTMS_Api
JWT_AUDIENCE=DTMS_Client

FRONTEND_PORT=4173
API_PORT=8080
FRONTEND_PUBLIC_URL=http://localhost:4173

# Used only when pulling the images published by GitHub Actions.
IMAGE_NAMESPACE=local/dtms
IMAGE_TAG=latest
